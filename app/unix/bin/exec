#!/bin/sh

cmd="$@"
if [ -z "$cmd" ]; then
	echo no command provided
	exit 1
fi

fshell=$(finger $(whoami) | sed -n 's/.*Shell: //p' | sed 1q)
: "${SHELL:=$fshell}"
: "${PLAN9:=/usr/local/plan9}"

export INSIDE_P9P=true

cd $HOME

case "$SHELL" in
*/rc)
	echo $cmd | $SHELL -l
	exit 0
	;;
*/bash)
	. ~/.bash_profile
	;;
*)
	. ~/.profile
	;;
esac

case ":$PATH" in
	*":$PLAN9/bin:"*) ;;
	*) PATH=$PATH:$PLAN9/bin ;;
esac

eval $cmd
exit 0
