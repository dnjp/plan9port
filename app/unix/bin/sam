#!/bin/sh

args="$@"
if [ "$(uname)" = "Linux" ]; then
	fshell=$(grep $(whoami) /etc/passwd | awk -F ':' '{print $NF}')
else
	fshell=$(finger $(whoami) | sed -n 's/.*Shell: //p' | sed 1q)
fi
: "${SHELL:=$fshell}"
: "${PLAN9:=/usr/local/plan9}"

export INSIDE_P9P=true
export INSIDE_9TERM=true

case "$SHELL" in
*/rc)
	echo '
		if(! ~ $PLAN9/bin $path)
			path=($path $PLAN9/bin)
		if(! ~ $#fixfont 0)
			font=$fixfont
		sam -a &
	' | $SHELL -l
	exit 0
	;;
*/bash)
	. ~/.bash_profile
	;;
*)
	. ~/.profile
	;;
esac

case ":$PATH" in
	*":$PLAN9/bin:"*) ;;
	*) PATH=$PATH:$PLAN9/bin ;;
esac

if [ ! -z "$fixfont" ]; then
	export font=$fixfont
fi

plumber &
fontsrv &
sam -a "$@" &
exit 0

